# Required OpenAI-compatible LLM configuration.
# mistral-medium-latest supports the tool-calling workflow used by the agent.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.mistral.ai/v1
LLM_MODEL=mistral-medium-latest

# Optional separate model for HyDE; blank falls back to LLM_MODEL.
HYDE_MODEL=

# Streamable HTTP MCP service.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_SERVER_URL=http://127.0.0.1:8000/mcp
MCP_CONNECT_TIMEOUT_SECONDS=15
MCP_AUTO_START_TIMEOUT_SECONDS=20
MCP_READ_TIMEOUT_SECONDS=120
MCP_TOOL_TIMEOUT_SECONDS=120

# LLM client behavior.
LLM_REQUEST_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=1
# HyDE is optional and fails back to the real query within the MCP timeout.
HYDE_REQUEST_TIMEOUT_SECONDS=45
HYDE_MAX_RETRIES=0
AGENT_PROGRESS=1

# Per-run safety budget. Zero prices keep free-tier billed cost at zero;
# AGENT_MAX_ESTIMATED_USD=0 disables only the monetary cap.
AGENT_MAX_LLM_CALLS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_INPUT_TOKENS=120000
AGENT_MAX_OUTPUT_TOKENS=8000
AGENT_INPUT_USD_PER_MILLION=0
AGENT_OUTPUT_USD_PER_MILLION=0
AGENT_MAX_ESTIMATED_USD=0

# Optional Langfuse tracing. Leave the keys blank to run without tracing.
LANGFUSE_ENABLED=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Set this to the base URL for the region that contains your Langfuse project.
LANGFUSE_BASE_URL=

# Retrieval defaults. The first retrieval run downloads these model weights.
EMBEDDING_MODEL=sentence-transformers/multi-qa-MiniLM-L6-cos-v1
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
# Examples: cpu, cuda, mps. Blank lets sentence-transformers choose.
RETRIEVAL_DEVICE=

# Full baseline-versus-final RAGAS evaluation. The answer and judge models
# default to LLM_MODEL; the evaluator embedding defaults to EMBEDDING_MODEL.
RAGAS_ANSWER_MODEL=
RAGAS_JUDGE_MODEL=
RAGAS_EMBEDDING_MODEL=
RAGAS_ANSWER_MAX_TOKENS=350
RAGAS_REQUEST_TIMEOUT_SECONDS=120
RAGAS_MAX_RETRIES=1
# Baseline/final cases in flight; each case runs the four judge metrics together.
RAGAS_MAX_CONCURRENT_PIPELINES=2
# Global cap for answer/metric call groups (metrics may make serial sub-calls).
RAGAS_MAX_CONCURRENT_LLM_GROUPS=3

# Optional processed-data path overrides. Blank values use data/measurements/processed.
AIR_QUALITY_ANNUAL_DATA=
AIR_QUALITY_EXCLUDED_DATA=
AIR_QUALITY_COUNTRY_SUMMARY_DATA=
