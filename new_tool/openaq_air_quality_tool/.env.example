# Create a free key at https://explore.openaq.org/
OPENAQ_API_KEY=

# Identify the application when using the public Nominatim service.
NOMINATIM_USER_AGENT=air-quality-agent/1.0 (+https://github.com/zaizou1003/Air-Quality-Agent)

# A measurement older than this is not returned as current (1 to 168 hours).
MAX_DATA_AGE_HOURS=24

# Overall lookup deadline and short-lived result cache.
LIVE_AIR_QUALITY_DEADLINE_SECONDS=90
LIVE_AIR_QUALITY_CACHE_SECONDS=300

# Standalone Streamable HTTP server (integration uses the main agent server).
LIVE_AIR_QUALITY_MCP_HOST=127.0.0.1
LIVE_AIR_QUALITY_MCP_PORT=8001

# Optional switchable service URLs. Only trusted operators should change these.
OPENAQ_BASE_URL=https://api.openaq.org/v3
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
